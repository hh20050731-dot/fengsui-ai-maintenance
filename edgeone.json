{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:edgeone",
  "outputDirectory": "apps/web/dist",
  "nodeVersion": "20.18.0",
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
