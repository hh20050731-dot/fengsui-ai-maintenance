# 服务端运行环境：development / production / test
NODE_ENV=development
# 运行模式：mock / feishu；飞书配置不完整时自动降级为 mock
APP_MODE=mock
# 对外可访问的 HTTPS 根地址，用于消息卡片跳转
APP_BASE_URL=http://localhost:5173
# 服务端端口
PORT=3001

# 飞书企业自建应用凭证（仅服务端读取；Mock 模式不需要）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书多维表格 App Token 及各数据表 ID（仅 Feishu 模式需要）
FEISHU_BITABLE_APP_TOKEN=
FEISHU_EQUIPMENT_TABLE_ID=
FEISHU_TELEMETRY_TABLE_ID=
FEISHU_HEALTH_TABLE_ID=
FEISHU_ALERT_TABLE_ID=
FEISHU_WORK_ORDER_TABLE_ID=
FEISHU_SPARE_PART_TABLE_ID=
FEISHU_SPARE_TRANSACTION_TABLE_ID=
FEISHU_KNOWLEDGE_TABLE_ID=
FEISHU_OPERATION_LOG_TABLE_ID=

# 机器人默认通知会话；不硬编码，Feishu 模式发送消息时需要
FEISHU_NOTIFICATION_CHAT_ID=

# 初始化/种子脚本安全开关：默认 true 只检查；确认后设置 false 才写入
DRY_RUN=true

# AI Provider：rule / openai / other；未配置 Key 时自动使用 rule
AI_PROVIDER=rule
OPENAI_API_KEY=
OPENAI_MODEL=

# 浏览器可见配置。VITE_FEISHU_APP_ID 可公开；严禁在 VITE_ 变量中放 App Secret
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_MODE=mock
VITE_FEISHU_APP_ID=
